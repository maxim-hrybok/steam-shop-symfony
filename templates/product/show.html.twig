{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} | Steam Card Shop{% endblock %}

{% block body %}

<main class="product-detail-container">
    <article class="product-detail">
        <div class="product-detail__image-wrapper">
            {% if product.imageFilename %}
                <img src="{{ asset('uploads/products/' ~ product.imageFilename) }}" alt="{{ product.name }}">
            {% else %}
                <div style="width: 100%; height: 300px; display: flex; align-items: center; justify-content: center; color: var(--text-muted);">
                    No image
                </div>
            {% endif %}
        </div>

        <div class="product-detail__info">
            <h1 class="product-detail__title">{{ product.name }}</h1>

            <div style="display: flex; gap: 5px; flex-wrap: wrap;">
                {% for category in product.categories %}
                    <span style="font-size: 12px; background: var(--accent); padding: 3px 8px; border-radius: 4px; color: white; font-weight: 500;">
                        {{ category.name }}
                    </span>
                {% endfor %}
            </div>

            <p class="product-detail__description">
                {{ product.description|nl2br }}
            </p>

            <div class="product-detail__pricing">
                {% if product.discount > 0 %}
                    <span class="new-price">${{ product.getDiscountedPrice()|number_format(2, '.', ',') }}</span>
                    <span class="old-price" style="text-decoration: line-through; color: var(--text-muted); margin-left: 10px;">${{ product.price|number_format(2, '.', ',') }}</span>
                {% else %}
                    <span class="price">${{ product.price|number_format(2, '.', ',') }}</span>
                {% endif %}
            </div>
            
            {% if product.stock > 0 %}
                <div class="text-success mb-2" style="font-weight: 600;">
                    In Stock: {{ product.stock }}
                </div>
                
                <form action="#" method="POST">
                    <button type="submit" class="product-detail__add-to-cart">Add to Cart</button>
                </form>
            {% else %}
                <div class="text-danger mb-2 font-large" style="font-weight: 600;">
                    OUT OF STOCK
                </div>
                <button class="product-detail__add-to-cart btn-disabled" disabled>Sold Out</button>
            {% endif %}
        </div>
    </article>
</main>
<!-- === Comments Section === -->
    <section class="comments-section" style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border);">
        <h2 style="margin-bottom: 20px;">Customer Reviews & Comments</h2>

        <!-- Form for adding a new comment -->
        <div class="comment-form-box" style="margin-bottom: 2rem;">
            {% if app.user %}
                {{ form_start(form) }}
                    <div class="form-group">
                        {{ form_row(form.content) }}
                    </div>
                    <button type="submit" class="btn-primary mt-2">Submit Comment</button>
                {{ form_end(form) }}
            {% else %}
                <p>Please <a href="{{ path('app_login') }}" class="text-primary font-weight-bold">Login</a> to leave a comment.</p>
            {% endif %}
        </div>

        <!-- List of approved comments -->
        <div class="comments-list">
            {% if comments is empty %}
                <p class="text-muted" style="font-style: italic;">No reviews yet. Be the first to comment!</p>
            {% else %}
                {% for comment in comments %}
                    <div class="comment-card mt-2" style="background: var(--bg-surface-hover); padding: 15px; border-radius: var(--radius);">
                        <div class="comment-card-header flex-between" style="margin-bottom: 10px;">
                            <strong class="comment-author" style="color: var(--primary);">{{ comment.user.firstName }}</strong>
                            <span class="comment-date text-muted" style="font-size: 0.85rem;">{{ comment.createdAt|date('M d, Y H:i') }}</span>
                        </div>
                        {# nl2br сохраняет переносы строк, e экранирует HTML от XSS атак #}
                        <p class="comment-body" style="margin: 0; line-height: 1.5;">{{ comment.content|e|nl2br }}</p>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </section>
{% endblock %}