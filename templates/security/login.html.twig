{% extends 'base.html.twig' %}

{% block title %}Log in! | Steam Card Shop{% endblock %}

{% block body %}
<main class="auth-container">
    <h2>Login to Your Account</h2>

    {# Block for displaying authentication errors (including our CAPTCHA error) #}
    {% if error %}
        <div class="alert-error">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    {# in case the user is already logged in #}
    {% if app.user %}
        <div class="mb-3" style="text-align: center;">
            You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
        </div>
    {% else %}

        <form method="post">
            <div class="form-group">
                <label class="form-label" for="username">Email:</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Password:</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
            </div>

            {# Hidden field with CSRF token required by Symfony for login #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            {# === RECAPTCHA WIDGET === #}
            <script src="https://www.google.com/recaptcha/api.js" async defer></script>
            <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key }}" style="margin-bottom: 15px;"></div>

            <button class="btn-primary" type="submit" style="width: 100%;">
                Login
            </button>
        </form>

        <p style="text-align: center; margin-top: 20px;">
            Don't have an account? <a href="{{ path('app_register') }}">Register here</a>
        </p>

    {% endif %}
</main>
{% endblock %}