{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<main class="main-container panel" style="text-align: center;">
    <h1 class="text-primary mb-2">Steam Card Shop</h1>
    <p class="font-large mb-2">Out products from the database (via Doctrine ORM)</p>
    
    <div class="product-grid mt-2">
        {% for product in products %}
            <div class="card">
                <div class="card__top">
                    
                    <a href="{{ path('app_product_show', {'id': product.id}) }}" class="card__image" style="display: block; width: 100%; height: 100%;">
                        {% if product.imageFilename %}
                            <img src="{{ asset('uploads/products/' ~ product.imageFilename) }}" alt="{{ product.name }}">
                        {% else %}
                            {# Placeholder, if the image is not yet uploaded #}
                            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #0b1121; color: var(--text-muted);">
                                No Image
                            </div>
                        {% endif %}
                    </a>
                    
                    {# Display product status #}
                    {% if product.status == 'available' %}
                        <div class="card__label" style="background: var(--success);">Available</div>
                    {% else %}
                        <div class="card__label" style="background: var(--danger);">Hidden</div>
                    {% endif %}
                </div>
                
                <div class="card__bottom">
                    <div class="card__prices">
                        <span class="price">${{ product.price|number_format(2, '.', ',') }}</span>
                    </div>
                    
                    <a href="{{ path('app_product_show', {'id': product.id}) }}" class="card__title">{{ product.name }}</a>
                    
                    <div style="margin-bottom: 15px; text-align: left;">
                        {% for category in product.categories %}
                            <span style="font-size: 12px; background: #3b82f6; padding: 2px 6px; border-radius: 4px; color: white;">
                                {{ category.name }}
                            </span>
                        {% endfor %}
                    </div>

                    <a href="{{ path('app_cart_add', {'id': product.id}) }}" class="card__add" style="display: block; text-align: center;">Add to Cart (Stock: {{ product.stock }})</a>
                </div>
            </div>
        {% else %}
            <p>No products available.</p>
        {% endfor %}
    </div>
</main>
{% endblock %}
