{% extends 'base.html.twig' %}
{% block title %}Create Product{% endblock %}

{% block body %}
<main class="panel main-container-sm">
    <h1>{{ app.request.attributes.get('_route') == 'app_admin_create' ? 'Create New Product' : 'Edit Product' }}</h1>

    {# Автоматический вывод формы. form_start сам добавляет CSRF-токен! #}
    {{ form_start(form) }}
        
        <div class="form-group">{{ form_row(form.name) }}</div>
        <div class="form-group">{{ form_row(form.price) }}</div>
        <div class="form-group">{{ form_row(form.description) }}</div>
        <div class="form-group">{{ form_row(form.stock) }}</div>
        <div class="form-group">{{ form_row(form.status) }}</div>
        
        <div class="form-group">
            <label class="form-label">Categories:</label>
            <div style="border: 1px solid var(--border); padding: 10px; border-radius: 4px;">
                {# Выведет наши чекбоксы для категорий #}
                {{ form_widget(form.categories) }}
            </div>
        </div>

        <button type="submit" class="btn-primary" style="width: 100%;">Save Product</button>
        
    {{ form_end(form) }}
</main>
{% endblock %}