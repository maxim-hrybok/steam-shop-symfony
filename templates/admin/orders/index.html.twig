{% extends 'base.html.twig' %}
{% block title %}Manage Orders{% endblock %}

{% block body %}
<main class="admin-dashboard">
    <div class="admin-header">
        <h1>Manage Orders</h1>
        <div class="admin-actions">
            <a href="{{ path('app_admin_index') }}" class="btn-secondary">&larr; Back to Products</a>
        </div>
    </div>

    <table class="admin-table mt-2">
        <thead>
            <tr>
                <th>ID</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for order in orders %}
            <tr>
                <td><strong>#{{ order.id }}</strong></td>
                <td>{{ order.user.email }}</td>
                <td>{{ order.createdAt|date('M d, Y H:i') }}</td>
                <td><strong>${{ order.totalPrice|number_format(2) }}</strong></td>
                <td>
                    <span class="text-{% if order.status == 'completed' %}success{% elseif order.status == 'cancelled' %}danger{% else %}warning{% endif %}" style="font-weight: bold; text-transform: uppercase;">
                        {{ order.status }}
                    </span>
                </td>
                <td>
                    <a href="{{ path('app_admin_orders_edit', {'id': order.id}) }}" class="btn-primary" style="padding: 5px 10px; font-size: 0.9rem;">View / Edit</a>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" class="text-center">No orders found.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</main>
{% endblock %}