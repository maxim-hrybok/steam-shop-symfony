{% extends 'base.html.twig' %}
{% block title %}Admin Dashboard{% endblock %}

{% block body %}
<main class="admin-dashboard">
    <div class="admin-header">
        <h1>Admin Dashboard - Products</h1>
        <div class="admin-actions">
            <a href="{{ path('app_admin_create') }}" class="btn-success">+ Add New Product</a>
        </div>
    </div>

    <table class="admin-table mt-2">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.name }}</td>
                <td>${{ product.price }}</td>
                <td>{{ product.stock }}</td>
                <td>{{ product.status }}</td>
                <td style="display: flex; gap: 10px;">
                    {# edit link #}
                    <a href="{{ path('app_admin_edit', {'id': product.id}) }}" class="btn-primary" style="padding: 5px 10px; font-size: 0.9rem;">Edit</a>

                    {# Delete form#}
                    <form method="post" action="{{ path('app_admin_delete', {'id': product.id}) }}" onsubmit="return confirm('Are you shure you wont to delete this product?');">
                        {# csrf_token() generates token for selected object#}
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                        <button class="btn-danger" style="padding: 5px 10px; font-size: 0.9rem;">Delete</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</main>
{% endblock %}