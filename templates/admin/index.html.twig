{% extends 'base.html.twig' %}
{% block title %}Admin Dashboard{% endblock %}

{% block body %}
<main class="admin-dashboard">
    <div class="admin-header">
        <h1>Admin Dashboard - Products</h1>
        <div class="admin-actions">
            <a href="{{ path('app_admin_create') }}" class="btn-success">+ Add New Product</a>
        </div>
    </div>

    <table class="admin-table mt-2">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.name }}</td>
                <td>${{ product.price }}</td>
                <td>{{ product.stock }}</td>
                <td>{{ product.status }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</main>
{% endblock %}