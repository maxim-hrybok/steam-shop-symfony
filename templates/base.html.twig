<!DOCTYPE html>
<html>
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Steam Card Shop{% endblock %}</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    {% block stylesheets %}
        {# 
           Function importmap() reads your assets/styles/app.css, 
           processes it, adds hashes for caching, and generates the necessary <link> tags. 
        #}
        {{ importmap('app') }}
    {% endblock %}
</head>

    <body>
        <header>
            <nav>
                <ul>
                    <li><a href="{{ path('app_home') }}">Home</a></li>
                    <li><a href="#">All Products</a></li>
                    {% set cart = app.session.get('cart', []) %}
                    {% set cartCount = 0 %}
                    {% for qty in cart %}
                        {% set cartCount = cartCount + qty %}
                    {% endfor %}

                <li id="logreg">
                    <a href="{{ path('app_cart_index') }}" class="cart-link">
                        Cart
                        {% if cartCount > 0 %}
                            <span class="cart-badge">{{ cartCount }}</span>
                        {% endif %}
                    </a>
                </li>
                    {# Check if user is loged in #}
                    {% if app.user %}
                    
                    {# Check user admin rights #}
                    {% if is_granted('ROLE_ADMIN') %}
                        <li><a href="{{ path('app_admin_index') }}" style="color: var(--accent);">Admin Panel</a></li>
                    {% endif %}

                    <li id="logreg"><a href="{{ path('app_logout') }}">Logout</a></li>
                    <li id="logreg"><a href="#">Hi, {{ app.user.firstName }}!</a></li>
                {% else %}
                        <li id="logreg"><a href="{{ path('app_login') }}">Login</a></li>
                        <li id="logreg"><a href="{{ path('app_register') }}">Register</a></li>
                    {% endif %}
                </ul>
            </nav>
        </header>


        {% block body %}{% endblock %}
    </body>
</html>
    